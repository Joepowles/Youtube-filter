# How people sign in:
#   password   = use from your home network, e.g. http://<container-ip>:8765 (the site's sign-in page asks for APP_PASSWORD)
#   cloudflare = only through Cloudflare Access at yt.example.com
AUTH_MODE=password
# 8+ characters; generate one with: openssl rand -base64 18
APP_PASSWORD=
# How long a sign-in lasts on each phone or computer, in days
SESSION_DAYS=30
# Cloudflare Access (Zero Trust > Settings > Custom pages shows your team domain;
# the AUD tag is on the Access application's Overview / Basic information tab)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=paste-the-application-audience-tag-here
# Optional extra check: only these signed-in emails may use the site
ALLOWED_EMAILS=
PORT=8765
# Chrome runs inside a virtual screen on the server, so leave this at 0
YT_HEADLESS=0
